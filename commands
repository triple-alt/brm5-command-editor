// ── Rendering ──
const sidebar = document.getElementById('sidebar');
const content = document.getElementById('content');
const search  = document.getElementById('search');
const ENUM_PREVIEW = 12;
let activeBtn = null;
let activeCmd = null;

document.getElementById('cmd-total').textContent = Object.keys(CMDS).length + ' commands';

function esc(s) {
  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function typeColor(type) {
  if (type === 'number')  return '#61afef';
  if (type === 'uid')     return '#c678dd';
  if (type === 'enum')    return '#e5c07b';
  if (type === 'string')  return '#98c379';
  if (type === 'command') return '#e06c75';
  return '#abb2bf';
}

function renderParamsTable(params) {
  if (!params.length) return '<p class="no-params">No parameters.</p>';
  const rows = params.map(p => {
    let extra = '';
    if (p.type === 'enum') {
      const all = p.values.map(esc).join(', ');
      if (p.values.length > ENUM_PREVIEW) {
        const preview = p.values.slice(0, ENUM_PREVIEW).map(esc).join(', ');
        extra =
          '<div class="param-enum">' +
            '<span class="enum-values" data-preview="' + esc(preview) + '" data-full="' + esc(all) + '">' + preview + '</span>' +
            '<div><button class="enum-toggle" data-open="0">Show all ' + p.values.length + '</button></div>' +
          '</div>';
      } else {
        extra = '<div class="param-enum"><span class="enum-values">' + all + '</span></div>';
      }
    }
    if (p.type === 'uid') extra = '<div class="param-enum">UUID or %variable</div>';
    const defStr = p.default !== undefined ? ' <span style="color:#4a4a4a">(default: ' + esc(p.default) + ')</span>' : '';
    return '<tr><td>' + esc(p.name) + defStr + '</td><td style="color:' + typeColor(p.type) + '">' + p.type + '</td><td>' + extra + '</td></tr>';
  }).join('');
  return '<table class="params-table"><thead><tr><th>parameter</th><th>type</th><th>values</th></tr></thead><tbody>' + rows + '</tbody></table>';
}

function renderCmd(name, spec) {
  let html = '<div class="cmd-name">' + esc(name) + '</div><div class="cmd-doc">' + esc(spec.doc) + '</div>';
  if (spec.subtypes) {
    html += '<div class="section-title">subtypes</div><div>';
    for (const [subName, sub] of Object.entries(spec.subtypes)) {
      const allParams = [...spec.params, ...(sub.params || [])];
      html += '<div class="subtype-block"><div class="subtype-name">' + esc(name) + ' ' + esc(subName) + '</div>' +
              '<div class="subtype-doc">' + esc(sub.doc) + '</div>' + renderParamsTable(allParams) + '</div>';
    }
    html += '</div>';
  } else {
    html += '<div class="section-title">parameters</div>' + renderParamsTable(spec.params);
  }
  if (spec.example) html += '<div class="section-title">example</div><div class="example">' + esc(spec.example) + '</div>';
  content.innerHTML = html;
  content.scrollTop = 0;

  content.querySelectorAll('.enum-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const span = btn.closest('.param-enum').querySelector('.enum-values');
      const open = btn.dataset.open === '1';
      span.textContent = open ? span.dataset.preview : span.dataset.full;
      btn.dataset.open = open ? '0' : '1';
      btn.textContent = open ? 'Show all ' + span.dataset.full.split(', ').length : 'Show fewer';
    });
  });
}

function selectCmd(name) {
  const btn = sidebar.querySelector('[data-cmd="' + name + '"]');
  if (activeBtn) activeBtn.classList.remove('active');
  if (btn) { btn.classList.add('active'); activeBtn = btn; }
  activeCmd = name;
  renderCmd(name, CMDS[name]);
  history.replaceState(null, '', '#' + name);
}

Object.entries(CMDS).forEach(([name, spec]) => {
  const btn = document.createElement('button');
  btn.className = 'cmd-btn';
  btn.dataset.cmd = name;
  btn.textContent = name;
  if (spec.subtypes) {
    const count = document.createElement('span');
    count.className = 'sub-count';
    count.textContent = Object.keys(spec.subtypes).length;
    btn.appendChild(count);
  }
  btn.addEventListener('click', () => selectCmd(name));
  sidebar.appendChild(btn);
});

const noMatch = document.createElement('div');
noMatch.id = 'no-match';
noMatch.textContent = 'No command matches.';
noMatch.style.display = 'none';
sidebar.appendChild(noMatch);

search.addEventListener('input', () => {
  const q = search.value.trim().toLowerCase();
  let visible = 0;
  sidebar.querySelectorAll('.cmd-btn').forEach(btn => {
    const name = btn.dataset.cmd;
    const spec = CMDS[name];
    const hit = name.includes(q) ||
      (spec.subtypes && Object.keys(spec.subtypes).some(s => s.includes(q)));
    btn.style.display = hit ? '' : 'none';
    if (hit) visible++;
  });
  noMatch.style.display = visible ? 'none' : '';
});

search.addEventListener('keydown', e => {
  if (e.key === 'Enter') {
    const first = Array.from(sidebar.querySelectorAll('.cmd-btn')).find(b => b.style.display !== 'none');
    if (first) selectCmd(first.dataset.cmd);
  }
});

const fromHash = decodeURIComponent(location.hash.slice(1));
selectCmd(CMDS[fromHash] ? fromHash : Object.keys(CMDS)[0]);
</script>
</body>
</html>
