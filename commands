<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Command Reference</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; background: #1a1a1a; overflow: hidden; }
body { font-family: Consolas, "Courier New", monospace; }

#app { display: flex; flex-direction: column; height: 100vh; }

#topbar {
  display: flex; align-items: center; gap: 12px;
  padding: 0 14px; height: 40px; flex-shrink: 0;
  background: #111; border-bottom: 1px solid #2a2a2a;
}
#topbar h1 { color: #abb2bf; font-size: 13px; font-weight: 600; }
#cmd-total { color: #4a4a4a; font-size: 11px; }
#search {
  margin-left: auto; width: 190px;
  background: #1e1e1e; border: 1px solid #333; border-radius: 3px;
  color: #abb2bf; font-family: inherit; font-size: 12px;
  padding: 4px 8px; outline: none;
}
#search:focus { border-color: #61afef; }
#search::placeholder { color: #4a4a4a; }

#layout { display: flex; flex: 1; min-height: 0; }

#sidebar {
  width: 170px; flex-shrink: 0; overflow-y: auto;
  border-right: 1px solid #2a2a2a; padding: 8px 0;
  scrollbar-width: thin; scrollbar-color: #333 transparent;
}
.cmd-btn {
  display: block; width: 100%; text-align: left;
  background: none; border: none; color: #777;
  font-family: inherit; font-size: 12px;
  padding: 5px 14px; cursor: pointer;
}
.cmd-btn:hover { background: #252525; color: #abb2bf; }
.cmd-btn.active { background: #2a3a4a; color: #61afef; }
.cmd-btn:focus-visible { outline: 1px solid #61afef; outline-offset: -1px; }
.cmd-btn .sub-count { color: #4a4a4a; font-size: 10px; margin-left: 4px; }
#no-match { color: #444; font-size: 11px; padding: 6px 14px; font-style: italic; }

#content {
  flex: 1; overflow-y: auto; padding: 20px 22px; min-width: 0;
  scrollbar-width: thin; scrollbar-color: #333 transparent;
}
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }
::-webkit-scrollbar-track { background: transparent; }

.cmd-name { color: #61afef; font-size: 18px; font-weight: 600; margin-bottom: 6px; }
.cmd-doc { color: #888; font-size: 12px; margin-bottom: 20px; line-height: 1.6; max-width: 68ch; }
.section-title { color: #555; font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; }
.params-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 12px; }
.params-table th { color: #555; font-weight: normal; text-align: left; padding: 3px 8px 5px 0; border-bottom: 1px solid #2a2a2a; }
.params-table td { padding: 5px 8px 5px 0; color: #abb2bf; vertical-align: top; border-bottom: 1px solid #1e1e1e; }
.params-table td:first-child { color: #c678dd; width: 110px; }
.params-table td:nth-child(2) { width: 80px; }
.param-enum { color: #666; font-size: 11px; margin-top: 2px; line-height: 1.6; }
.enum-values { word-break: break-word; }
.enum-toggle {
  background: none; border: 1px solid #333; border-radius: 3px;
  color: #61afef; font-family: inherit; font-size: 10px;
  padding: 1px 6px; margin-top: 5px; cursor: pointer;
}
.enum-toggle:hover { background: #252525; border-color: #61afef; }
.subtype-block { margin-bottom: 16px; border-left: 2px solid #2a3a4a; padding-left: 12px; }
.subtype-name { color: #98c379; font-size: 13px; font-weight: 600; margin-bottom: 4px; }
.subtype-doc { color: #777; font-size: 11px; margin-bottom: 8px; }
.example {
  background: #161616; border: 1px solid #2a2a2a; border-radius: 4px;
  padding: 8px 12px; font-size: 12px; color: #abb2bf;
  margin-bottom: 20px; white-space: pre; overflow-x: auto;
}
.no-params { color: #444; font-size: 12px; margin-bottom: 16px; font-style: italic; }
#placeholder { color: #444; font-size: 12px; }

@media (max-width: 620px) {
  #sidebar { width: 120px; }
  #content { padding: 14px; }
  #search { width: 120px; }
}
</style>
</head>
<body>
<div id="app">
